ANYCONNECT_SERVERS=mci3.npvip.net,mci2.npvip.net,mci1.npvip.net,mci.npvip.net
VPN_RECONNECT_SECONDS=43200
# A spare VPN compares servers every 30 minutes. A handover keeps both up for 5 minutes.
VPN_SCAN_INTERVAL=1800
VPN_OVERLAP_SECONDS=300
VPN_SWITCH_PERCENT=25
VPN_SPEED_SAMPLES=2
VPN_SPEED_TIMEOUT=20
VPN_SPEED_MIN_BYTES=900000
VPN_SPEED_URL="https://speed.cloudflare.com/__down?bytes=1000000"
# Optional DNS override inside the VPN. Otherwise use the VPN-provided DNS.
# VPN_DNS="1.1.1.1 8.8.8.8"
ANYCONNECT_USER=your_username
ANYCONNECT_PASSWORD=your_password
# Optional verified server pin. Empty accepts the certificate automatically.
ANYCONNECT_SERVERCERT=

# Check internet through SOCKS at startup and every 60 seconds.
VPN_CHECK_INTERVAL=60
VPN_CHECK_TIMEOUT=10
VPN_CHECK_ATTEMPTS=2
VPN_CHECK_URLS="https://www.gstatic.com/generate_204 https://www.cloudflare.com/cdn-cgi/trace"
